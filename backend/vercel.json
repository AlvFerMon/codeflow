{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.7.4" }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "/(.*\\.(?:ico|png|jpg|jpeg|gif|svg|webp|css|js|woff|woff2|txt|xml))", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}