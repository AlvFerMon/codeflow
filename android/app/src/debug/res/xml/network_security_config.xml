<?xml version="1.0" encoding="utf-8"?>
<!--
    SOLO DEBUG. Permite HTTP (sin TLS) para hablar con el backend en Docker del PC:
      - emulador → 10.0.2.2:8080
      - móvil físico en la misma Wi-Fi → IP del PC, p. ej. 192.168.1.50:8080
    La IP de la red local cambia según la Wi-Fi, así que en debug se permite HTTP a cualquier
    host. La build release no incluye este fichero: allí solo se permite HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
