# CodeFlow — .env de PRODUCCIÓN (servidor propio). Copia este fichero como .env en el servidor
# y cambia TODAS las contraseñas. Guía: docs/DESPLIEGUE.md

# Usa docker-compose.yml + docker-compose.prod.yml en cada comando (Windows separa con ";")
COMPOSE_FILE=docker-compose.yml;docker-compose.prod.yml
# ia = Ollama + cola de análisis · duckdns = actualiza la IP del subdominio
COMPOSE_PROFILES=ia,duckdns

# Dominio público (sin https://). Para probar antes de abrir puertos: CODEFLOW_DOMAIN=localhost
CODEFLOW_DOMAIN=codeflow-tfg.duckdns.org
DUCKDNS_SUBDOMAIN=codeflow-tfg
DUCKDNS_TOKEN=pega_aqui_tu_token_de_duckdns

# Puertos locales (solo accesibles desde el propio servidor)
APP_PORT=8080
MAILPIT_PORT=8025
DB_FORWARD_PORT=3307

# MySQL
DB_DATABASE=codeflow
DB_USERNAME=codeflow
DB_PASSWORD=cambia_esta_contraseña_larga
DB_ROOT_PASSWORD=cambia_esta_contraseña_root_larga

# Usuarios: admin inicial; sin usuarios de prueba en producción
CODEFLOW_SEED_DEMO=false
SEED_ADMIN_EMAIL=admin@tu-correo.com
SEED_ADMIN_PASSWORD=cambia_esta_contraseña_admin
SEED_DEMO_PASSWORD=cambia_esta_contraseña_demo

# Correo. Vacío = los correos van a Mailpit (http://localhost:8025 en el servidor).
# Para enviarlos de verdad (p. ej. Gmail con contraseña de aplicación):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_cuenta@gmail.com
# MAIL_PASSWORD=contraseña_de_aplicacion
# MAIL_FROM_ADDRESS=tu_cuenta@gmail.com

# Límites de subida
CODEFLOW_MAX_FILE_MB=50
CODEFLOW_MAX_UPLOAD_MB=500
CODEFLOW_MAX_FILES=1000

# IA (la GTX 1660 Super con 6 GB mueve bien el modelo 7b)
CODEFLOW_AI_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
CODEFLOW_AI_TIMEOUT=300

# Copias de seguridad en la carpeta backups/
BACKUP_KEEP_DAYS=14
BACKUP_EVERY_HOURS=24
