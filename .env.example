# Variables de Docker Compose (copia este fichero como .env y cambia las contraseñas)
APP_PORT=8080
MAILPIT_PORT=8025

# MySQL (también son las credenciales para DBeaver: localhost:DB_FORWARD_PORT)
DB_FORWARD_PORT=3307
DB_DATABASE=codeflow
DB_USERNAME=codeflow
DB_PASSWORD=cambia_esta_contraseña
DB_ROOT_PASSWORD=cambia_esta_contraseña_root

# Datos de prueba (usuarios demo). Pon CODEFLOW_SEED_DEMO=false en producción.
CODEFLOW_SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@codeflow.test
SEED_ADMIN_PASSWORD=cambia_esta_contraseña_admin
SEED_DEMO_PASSWORD=cambia_esta_contraseña_demo

# Límites de subida de archivos (MB por archivo, MB por subida, nº de archivos por subida)
CODEFLOW_MAX_FILE_MB=50
CODEFLOW_MAX_UPLOAD_MB=500
CODEFLOW_MAX_FILES=1000

# IA opcional: revisión de pull requests con un modelo local (Ollama). Ver README › Revisión con IA
# Activar: CODEFLOW_AI_ENABLED=true y descomentar COMPOSE_PROFILES=ia (arranca Ollama y la cola de análisis
# con el resto de servicios; sin esa línea hay que añadir --profile ia a cada comando de docker compose)
CODEFLOW_AI_ENABLED=false
# COMPOSE_PROFILES=ia
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:3b
CODEFLOW_AI_TIMEOUT=300
# Con gráfica NVIDIA la IA va mucho más rápida: descomenta (Windows separa con ";")
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
# Ajustes finos (valores por defecto): tamaño de cada parte, total repartido entre archivos, respuesta máxima
# CODEFLOW_AI_BATCH_CHARS=20000
# CODEFLOW_AI_MAX_CHARS=60000
# CODEFLOW_AI_MAX_FILES=60
# CODEFLOW_AI_MAX_OUTPUT=1024
# CODEFLOW_AI_CONTEXT=12288
