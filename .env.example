# Variables de Docker Compose (copia este fichero como .env y cambia las contraseñas)
APP_PORT=8080
MAILPIT_PORT=8025

# MySQL (también son las credenciales para DBeaver: localhost:DB_FORWARD_PORT)
DB_FORWARD_PORT=3307
DB_DATABASE=codeflow
DB_USERNAME=codeflow
DB_PASSWORD=cambia_esta_contraseña
DB_ROOT_PASSWORD=cambia_esta_contraseña_root

# Datos de prueba (usuarios demo). Pon CODEFLOW_SEED_DEMO=false en producción.
CODEFLOW_SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@codeflow.test
SEED_ADMIN_PASSWORD=cambia_esta_contraseña_admin
SEED_DEMO_PASSWORD=cambia_esta_contraseña_demo
